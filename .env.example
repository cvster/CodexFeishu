# Optional Codex CLI override. By default the newest Codex Desktop bundled codex.exe is used.
# MOBILE_CODEX_CLI=C:\Users\you\AppData\Local\OpenAI\Codex\bin\<version>\codex.exe

# Optional native queue delivery timeout.
# MOBILE_CODEX_QUEUE_TIMEOUT_MS=120000

# Optional private-overlay IPv4 address exposed by nginx (for example StarVPN).
MOBILE_CODEX_PRIVATE_IP=
